# ===================================================================
# ENVIRONMENT VARIABLES - PHASE 0 (Foundation)
# ===================================================================
# Copy this file to .env and fill in your actual values
#
# IMPORTANT:
# - .env is PRIVATE (never commit to git)
# - .env.example is PUBLIC (shows what variables are needed)
# - This way, other developers know what env vars to set

# ===================================================================
# PHASE 0: Only these are needed
# ===================================================================

# Frontend URL (for CORS)
# Where is your frontend hosted?
FRONTEND_URL=https://your-frontend.vercel.app

# Environment
# dev = development (hot reload, verbose logging)
# prod = production (optimized, minimal logging)
ENVIRONMENT=dev

# Port to run on
PORT=8000

# ===================================================================
# PHASE 1: You'll add these later
# ===================================================================

# Fred API (Macro Data)
# Get free key: https://fred.stlouisfed.org/
FRED_API_KEY=your_fred_key_here

# Twelve Data API (Quotes, OHLCV, WebSocket streaming — commercial use OK)
# Free tier: 800 credits/day, 8 req/min
# Get key: https://twelvedata.com/account/api-keys
TWELVE_DATA_API_KEY=your_twelve_data_key_here

# Finnhub API (Company Data)
# Get free key: https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_key_here

# ===================================================================
# DATABASE: You'll add this during phase 0 deployment
# ===================================================================
# On Railway, this is auto-generated
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://localhost/monte_carlo_dev

# ===================================================================
# LOGGING
# ===================================================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
